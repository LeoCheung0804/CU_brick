{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "process",
            "label": "C/C++: cl.exe build active file",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\build.ps1",
                "-Target",
                "Main"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Discover Visual Studio and build the x86 controller executable."
        },
        {
            "type": "process",
            "label": "Test: offline unit tests",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\test\\run_offline_tests.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "detail": "Build and run hardware-independent controller and trajectory tests."
        },
        {
            "type": "process",
            "label": "C/C++: cl.exe build GUI",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\build.ps1",
                "-Target",
                "GUI"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build"
            },
            "detail": "Discover Visual Studio and build the x86 wxWidgets GUI."
        },
        {
            "type": "process",
            "label": "C/C++: cl.exe build Delta Server",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\build.ps1",
                "-Target",
                "DeltaServer"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build"
            },
            "detail": "Discover Visual Studio and build the x86 Delta server."
        },
        {
            "type": "process",
            "label": "C/C++: cl.exe build test file",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\tools\\build.ps1",
                "-Target",
                "LegacyTest"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build"
            },
            "detail": "Discover Visual Studio and build the legacy Teknic test executable."
        }
    ]
}
