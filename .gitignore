# MSVC compiler and linker intermediates
/temp/
*.obj
*.pch
*.pdb
*.idb
*.ilk
*.iobj
*.ipdb
*.tlog
*.lastbuildstate
*.VC.db
*.VC.VC.opendb

# Executables generated by the repository build script.
# Runtime DLLs in bin/ and vendor binaries in Dependencies/ remain trackable.
/bin/*.exe
/bin/*.manifest

# Visual Studio and editor-local state
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
.idea/
*.swp
*.swo
*~

# Alternative build-system output
/build/
/out/
/cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json

# Runtime logs
*.log
/bin/log.txt

# Python environments and generated files
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
*.egg-info/

# Local environment configuration
.env
.env.*
!.env.example

# Arduino and PlatformIO output
.pio/
.pioenvs/
.piolibdeps/
*.elf
*.hex

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
